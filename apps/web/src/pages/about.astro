---
import SocialIcon from '../components/site/SocialIcon.astro';
import Base from '../layouts/Base.astro';
import { organization } from '../lib/seo';
import { SITE_URL } from '../lib/site';
import { FOUNDER, HELPERS, TEAM } from '../lib/team';

const LINKS = [
  ['github', 'GitHub'],
  ['linkedin', 'LinkedIn'],
  ['x', 'X'],
] as const;

// Tells search engines who makes Dropzy: founders as founders, everyone else as members.
const person = (m: (typeof TEAM)[number]) => ({
  '@type': 'Person',
  name: m.name,
  jobTitle: m.role,
  image: `${SITE_URL}${m.photo}`,
  sameAs: Object.values(m.links),
});
const org = {
  ...organization,
  founder: TEAM.filter((m) => m.role === 'Founder').map(person),
  member: TEAM.filter((m) => m.role !== 'Founder').map(person),
};
---

<Base
  title="About Dropzy"
  description="Why Dropzy exists and who makes it: moving a file between your own devices shouldn’t need an app, an account or a cable."
  jsonLd={[org]}
>
  <article class="mx-auto max-w-3xl py-8">
    <h1 class="text-3xl font-bold tracking-tight text-balance text-slate-900 sm:text-4xl dark:text-white">The people behind Dropzy</h1>
    <div class="prose-dz mt-4">
      <p>We built Dropzy because moving a file from one device to another shouldn’t be a whole process.</p>
      <p>No paid plans. No accounts. No tracking cookies.</p>
      <p>Just a simple tool we wanted to use ourselves, so we built it, shipped it, and put it out there.</p>
    </div>

    <!-- The founder, featured. -->
    <section class="card mt-8 flex flex-col gap-5 p-6 sm:flex-row sm:items-center" aria-label={FOUNDER.name}>
      <img
        src={FOUNDER.photo}
        alt={FOUNDER.name}
        width="112"
        height="112"
        class="size-24 shrink-0 rounded-full object-cover ring-4 ring-accent-soft sm:size-28"
      />
      <div class="flex min-w-0 flex-col gap-2">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">{FOUNDER.name}</h2>
          <p class="font-medium text-accent-ink dark:text-accent">{FOUNDER.role}</p>
        </div>
        <p class="text-slate-700 dark:text-slate-300">{FOUNDER.bio}</p>
        <div class="flex gap-2">
          {
            LINKS.filter(([k]) => FOUNDER.links[k]).map(([k, label]) => (
              <a
                href={FOUNDER.links[k]}
                target="_blank"
                rel="noopener noreferrer me"
                aria-label={`${FOUNDER.name} on ${label}`}
                title={label}
                class="inline-flex size-10 items-center justify-center rounded-xl border border-slate-200 text-slate-800 transition-colors hover:border-accent/60 hover:bg-accent-soft hover:text-accent-ink dark:border-night-line dark:text-slate-100"
              >
                <SocialIcon name={k} size={18} />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      HELPERS.length > 0 && (
        <section class="mt-8" aria-labelledby="helpers-title">
          <h2 id="helpers-title" class="text-sm font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
            Helping spread the word
          </h2>
          {/* Three per row; a short last row sits centred. */}
          <ul class="mt-3 flex flex-wrap justify-center gap-3">
            {HELPERS.map((m) => (
              <li class="card flex w-full flex-col gap-3 p-4 sm:w-[calc((100%-1.5rem)/3)]">
                <div class="flex items-center gap-3">
                  <img src={m.photo} alt={m.name} width="40" height="40" loading="lazy" class="size-10 shrink-0 rounded-full object-cover" />
                  <div class="min-w-0">
                    <h3 class="truncate text-sm font-semibold text-slate-900 dark:text-white">{m.name}</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{m.role}</p>
                  </div>
                </div>
                <p class="text-sm text-slate-600 dark:text-slate-400">{m.bio}</p>
                <div class="flex gap-1.5">
                  {LINKS.filter(([k]) => m.links[k]).map(([k, label]) => (
                    <a
                      href={m.links[k]}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${m.name} on ${label}`}
                      title={label}
                      class="inline-flex size-8 items-center justify-center rounded-lg border border-slate-200 text-slate-700 transition-colors hover:border-accent/60 hover:bg-accent-soft hover:text-accent-ink dark:border-night-line dark:text-slate-200"
                    >
                      <SocialIcon name={k} size={14} />
                    </a>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose-dz mt-10">
      <h2>Why Dropzy</h2>
      <p>
        You have a photo on your phone and you need it on your laptop. Or a link on your computer that you want on your phone.
        It should take seconds, but it usually means installing an app, signing in to something, emailing yourself, or hunting
        for a cable.
      </p>
      <p>
        Dropzy is the shortcut. Open it on both devices and they find each other. Drop in files or text and they show up on the
        other side — straight across when they can, uploaded for a few hours when they can’t, and deleted automatically either
        way.
      </p>
      <h2>What we care about</h2>
      <ul>
        <li><strong>Easy.</strong> Opening the page is the whole setup. One obvious next step on every screen.</li>
        <li><strong>Free.</strong> No paid plans and no accounts. Dropzy is built to run on free tiers.</li>
        <li>
          <strong>Private by default.</strong> Everything is temporary, Private Share is end-to-end encrypted, there are no cookies, and
          we never store IP addresses.
        </li>
        <li><strong>Lean.</strong> Pages load fast, even on a phone on a slow connection.</li>
      </ul>
    </div>

    <div class="card mt-10 flex flex-col items-start gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-semibold text-slate-900 dark:text-white">Got feedback? Come say hi.</p>
      <a href="/contact" class="btn-primary">Contact us</a>
    </div>
  </article>
</Base>
