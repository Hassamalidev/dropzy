---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="card mx-auto my-10 max-w-xl p-8 text-center">
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">We couldn’t find that page</h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">It may have moved, or the share it belonged to has ended.</p>
    <a href="/" class="btn-primary mt-6">Go to Dropzy</a>
  </section>
</Base>
