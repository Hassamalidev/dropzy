---
import type { NavKey } from '../../lib/site';
import { t } from '../../strings/en';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  active: NavKey;
}
const { active } = Astro.props;
const items = [
  { key: 'wifi', href: '/', icon: 'wifi', label: t.nav.wifi, long: t.nav.wifiLong },
  { key: 'private', href: '/private', icon: 'lock', label: t.nav.private, long: t.nav.privateLong },
  { key: 'room', href: '/room/new', icon: 'users', label: t.nav.room, long: t.nav.roomLong },
  { key: 'join', href: '/join', icon: 'login', label: t.nav.join, long: t.nav.joinLong },
  { key: 'nearby', href: '/nearby', icon: 'radar', label: t.nav.nearby, long: t.nav.nearbyLong },
] as const;
---

<!-- Sticky above the page; z-40 keeps it under dialogs, toasts and the drag overlay (z-50). -->
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white dark:border-night-line dark:bg-night">
  <div class="mx-auto flex h-16 max-w-[1160px] items-center justify-between gap-3 px-4">
    <a href="/" class="flex items-center gap-2 rounded-xl text-lg font-semibold text-slate-900 dark:text-white">
      <span class="inline-flex size-9 items-center justify-center rounded-xl bg-brand text-white">
        <Icon name="droplet" size={20} />
      </span>
      {t.brand}
    </a>
    <div class="flex items-center gap-2">
      <nav aria-label={t.nav.label} class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {
            items.map((i) => (
              <li>
                <a
                  href={i.href}
                  aria-current={active === i.key ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-10 items-center gap-1.5 rounded-xl px-2 text-sm font-medium whitespace-nowrap transition-colors duration-150 md:gap-2 md:px-3 lg:px-3.5',
                    active === i.key
                      ? 'bg-accent-soft text-accent-ink'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white',
                  ]}
                >
                  <Icon name={i.icon} size={16} />
                  <span class="lg:hidden">{i.label}</span>
                  <span class="hidden lg:inline">{i.long}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <span class="hidden h-6 w-px bg-slate-200 sm:block dark:bg-night-line" aria-hidden="true"></span>
      <ThemeToggle />
    </div>
  </div>
</header>
