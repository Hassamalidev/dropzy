---
import { API_URL } from '../../lib/site';
import { t } from '../../strings/en';

// "Starting your private share…" / "Creating your room…" — creates the space, then a full-page
// navigation into it (§7.2, §7.3). One small script; no React.
interface Props {
  kind: 'private' | 'room';
}
const { kind } = Astro.props;
const msg = {
  failed: t.starting.failed,
  rateLimited: t.moments.rateLimited,
  capacity: t.moments.atCapacity('{time}'),
};
---

<section class="card mx-auto my-10 flex max-w-md flex-col items-center gap-4 p-8 text-center" aria-live="polite">
  <svg id="start-spin" class="size-8 animate-spin text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="3"></circle>
    <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  <p id="start-text" class="text-lg text-slate-700 dark:text-slate-200">
    {kind === 'private' ? t.starting.private : t.starting.room}
  </p>
  <button id="start-retry" type="button" class="btn-primary hidden">{t.starting.retry}</button>
</section>

<div id="start" hidden data-api={API_URL} data-kind={kind} data-msg={JSON.stringify(msg)}></div>

<script>
  import { fromShareSecret, newShareSecret } from '../../lib/crypto/keys';

  const cfg = document.getElementById('start') as HTMLElement;
  const { api, kind } = cfg.dataset as { api: string; kind: 'private' | 'room' };
  const msg = JSON.parse(cfg.dataset.msg as string) as { failed: string; rateLimited: string; capacity: string };
  const text = document.getElementById('start-text') as HTMLElement;
  const spin = document.getElementById('start-spin') as unknown as HTMLElement;
  const retry = document.getElementById('start-retry') as HTMLElement;
  const nextMidnight = () => {
    const n = new Date();
    return new Date(Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), n.getUTCDate() + 1)).toLocaleTimeString([], {
      hour: 'numeric',
      minute: '2-digit',
    });
  };

  async function create(path: string, body?: unknown) {
    const res = await fetch(`${api}/v1/${path}`, {
      method: 'POST',
      credentials: 'omit',
      headers: body ? { 'Content-Type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
    const json = await res.json().catch(() => ({ ok: false, error: res.status === 503 ? 'at_capacity' : 'x' }));
    if (!json.ok) throw new Error(json.error);
    return json.data;
  }

  async function go() {
    retry.classList.add('hidden');
    spin.classList.remove('hidden');
    try {
      if (kind === 'private') {
        // One secret makes both the share's id and its key; only the id goes to the server (§10).
        const secret = newShareSecret();
        const { token } = await fromShareSecret(secret);
        await create('sessions', { token });
        location.replace(`/s#${secret}`);
      } else {
        const data = await create('rooms');
        location.replace(`/r/${data.token}`);
      }
    } catch (e) {
      spin.classList.add('hidden');
      const code = String((e as Error)?.message || '');
      text.textContent =
        code === 'rate_limited' ? msg.rateLimited : code === 'at_capacity' ? msg.capacity.replace('{time}', nextMidnight()) : msg.failed;
      retry.classList.remove('hidden');
    }
  }
  retry.addEventListener('click', go);
  go();
</script>
