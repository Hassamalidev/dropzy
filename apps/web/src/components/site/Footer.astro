---
import { t } from '../../strings/en';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const links = [
  ['/', t.nav.wifiLong],
  ['/private', t.nav.privateLong],
  ['/room/new', t.nav.roomLong],
  ['/join', t.nav.joinLong],
  ['/nearby', t.nav.nearbyLong],
  ['/how-it-works', t.footer.howItWorks],
  ['/guides', t.footer.guides],
  ['/about', t.footer.about],
  ['/contact', t.contact],
  ['/privacy', t.footer.privacy],
  ['/terms', t.footer.terms],
];
---

<footer class="mt-10 border-t border-slate-200 bg-white dark:border-night-line dark:bg-night">
  <div class="mx-auto flex max-w-[1160px] flex-col gap-4 px-4 py-5 text-sm text-slate-500 lg:flex-row lg:items-center lg:justify-between dark:text-slate-400">
    <p class="flex items-center gap-2">
      <span class="inline-flex size-6 items-center justify-center rounded-lg bg-brand text-white">
        <Icon name="droplet" size={14} />
      </span>
      {t.footer.copyright(year)}
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        links.map(([href, label]) => (
          <li>
            <a href={href} class="hover:text-slate-900 dark:hover:text-white">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
