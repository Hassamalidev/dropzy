{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "e2e", "playwright.config.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "baseUrl": ".",
    "paths": { "~/*": ["src/*"] }
  }
}
